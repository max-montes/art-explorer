# Local, open-source default. The model is downloaded on first use and cached locally.
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Use "memory" for the zero-infrastructure demo or "postgres" after running Docker Compose.
CATALOG_REPOSITORY=memory
DATABASE_URL=postgres://art_explorer:art_explorer@localhost:5432/art_explorer

# Curator state and digest-keyed media persist under ignored local app data.
CURATION_INDEX_PATH=.local-data/curation-index.json
CURATION_MEDIA_PATH=.local-data/media
CURATION_THUMBNAIL_PATH=.local-data/thumbnails

# Approved files are copied here using safe original filenames.
CURATED_MEDIA_PATH=/absolute/path/to/CuratedArtwork

# The curator API rejects non-local hosts unless explicitly enabled.
ALLOW_REMOTE_CURATION=false
