# Use "transformers" for local Q4 inference or "jina-api" for hosted full precision.
EMBEDDING_PROVIDER=transformers
# Auto-routes named art movements/styles to SigLIP; set to jina-only to disable.
QUERY_MODEL_ROUTING=auto
STYLE_EMBEDDING_MODEL=Xenova/siglip-base-patch16-224
# Set to off only to reproduce legacy local-Jina query rankings.
JINA_QUERY_TASK=on
IMAGE_EMBEDDING_MODEL=jinaai/jina-clip-v2
JINA_API_KEY=
JINA_API_BATCH_SIZE=16
# Keep interactive inference responsive; increase intra-op threads for offline ingestion.
ONNX_INTRA_OP_THREADS=1
ONNX_INTER_OP_THREADS=1
# Mount this path on persistent storage in production to avoid downloading
# model files again after every deploy.
TRANSFORMERS_CACHE_DIR=.cache

# Use "memory" for the zero-infrastructure demo or "postgres" after running Docker Compose.
CATALOG_REPOSITORY=memory
DATABASE_URL=postgres://art_explorer:art_explorer@localhost:5432/art_explorer

# Curator state and digest-keyed media persist under ignored local app data.
CURATION_INDEX_PATH=.local-data/curation-index.json
CURATION_MEDIA_PATH=.local-data/media
CURATION_THUMBNAIL_PATH=.local-data/thumbnails

# Approved files are copied here using safe original filenames.
CURATED_MEDIA_PATH=/absolute/path/to/CuratedArtwork

# The curator API rejects non-local hosts unless explicitly enabled.
ALLOW_REMOTE_CURATION=false
